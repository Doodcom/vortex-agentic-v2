+  const isnum = typeof length === 'number';
+  const istype = isType(length);
+  const isfunc = isFunction(length);
+
+  if (!isnum && !istype && !isfunc) {
+    throw new TypeError('Unknown type of argument #1.');
+  }
+
+  return {
+    encode,
+    decode,
+    encodingLength,
+  };

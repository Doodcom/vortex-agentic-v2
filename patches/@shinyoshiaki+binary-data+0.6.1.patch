+    assertSize(size, this.length);
+
+    const buf = this.slice(0, size);
+    this.consume(size);
+
+    return buf;
+  }
+
+  /**
+   * Write provided chunk to the stream.
+   * @param {Buffer} chunk
+   */
+  writeBuffer(chunk) {
+    this.append(chunk);
+  }
+}

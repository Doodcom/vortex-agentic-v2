+    // eslint-disable-next-line no-invalid-this
+    const context = Metadata.clone(this);
+    decode.bytes = 0;
+
+    const count = isFunction(size) ? size(context) : size;
+
+    if (count === 0) {
+      Metadata.clean(context);
+      return;
+    }
